{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-24",

  // Fully static site: there is NO "main", so no worker is ever uploaded.
  // That was the origin of the "Uploading a Pages _worker.js directory as an
  // asset" error: wrangler treated the server bundle as a public asset.
  // If SSR with @astrojs/cloudflare is ever added, "main":
  // "./dist/_worker.js/index.js" must be added here, not an empty .assetsignore.
  "assets": {
    "directory": "./dist",
    // Astro generates directory URLs (/es/about/index.html); "404-page"
    // serves dist/404.html for anything that does not exist.
    "not_found_handling": "404-page"
  }
}
