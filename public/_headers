# Headers for Cloudflare Workers static assets.
# Wrangler reads this file from the root of dist/ and does NOT upload it as an asset.
#
# CAREFUL: matching rules ACCUMULATE, they do not override each other. If /* set
# a Cache-Control, /_astro/* would end up with both values concatenated
# ("immutable, max-age=0, must-revalidate"), which is contradictory. That is why
# Cache-Control is only declared in specific rules.

# Astro bundles carry a hash in their name: cache them forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

# HTML keeps Cloudflare's default (max-age=0, must-revalidate), so a deploy is
# visible instantly without declaring it here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
