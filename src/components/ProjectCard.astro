---
import Corners from "./Corners.astro";
import Github from "../assets/github.astro";
import { getTranslations } from "../i18n";
import type { Language } from "../types/language.type";
import type { Project } from "../types/project.type";

interface Props {
  project: Project;
}

const lang = Astro.params.lang as Language;
const t = getTranslations(lang);

const { project } = Astro.props;
const href = `${import.meta.env.BASE_URL}${lang}/projects/${project.link}`;
---

<!-- Celda de wireframe: cuadrada, transparente, con marcas de registro. La
     fotografía pasa por el duotono de acero, como una serigrafía. -->
<article class="bp bp-hover flex flex-col">
  <Corners />

  <div class="duotone border-b border-rule">
    <img
      class="w-full h-48 object-cover"
      src={project.img}
      alt={project.title}
    />
  </div>

  <div class="p-6 flex flex-1 flex-col justify-between gap-6">
    <div>
      <div class="flex items-start justify-between gap-4">
        <div>
          {project.working && <span class="kicker">{t.projects.developing}</span>}
          <h3 class="font-heading text-xl font-semibold uppercase tracking-[0.02em]">{project.title}</h3>
        </div>
        {project.git_hub_link_show &&
          <a
            href={project.git_hub_link}
            aria-label={`${project.title} — GitHub`}
            class="btn btn-icon shrink-0"
          ><Github/></a>
        }
      </div>
      <p class="mt-3 text-muted line-clamp-3">
        {project.description}
      </p>
    </div>

    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {project.stack.map((item) => (
          <span class="tag tag-accent">{item}</span>
        ))}
      </div>
      {project.show_link && (
        <a href={href} class="btn btn-ghost shrink-0">
          {t.projects.show_details}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
            <path d="M11 13l9 -9" />
            <path d="M15 4h5v5" />
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
