---
const { project } = Astro.props;
---

<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition duration-300 transform hover:-translate-y-1">
  <img
    class="w-full h-48 object-cover"
    src={project.img}
    alt="Imagen de Proyecto 1"
  />
  <div class="p-6">
    <h3 class="text-xl font-bold text-cyan-700 mb-2">{project.title}</h3>
    <p class="text-gray-600 line-clamp-3">
      {project.description}
    </p>
    <a
      href="#"
      class="mt-4 inline-block text-sm font-semibold text-cyan-500 hover:text-cyan-700"
    >
      Ver Detalles
    </a>
  </div>
</div>
