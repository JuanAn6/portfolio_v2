---
const { project } = Astro.props;
---

<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition duration-300 transform hover:-translate-y-1">
  <img
    class="w-full h-48 object-cover"
    src={project.img}
    alt="Imagen de Proyecto 1"
  />
  <div class="p-6">
    <h3 class="text-xl font-bold text-cyan-700 mb-2">{project.title}</h3>
    <p class="text-gray-600 line-clamp-3">
      {project.description}
    </p>
    <a
      href="#"
      class="mt-4 inline-flex text-sm font-semibold text-cyan-700 hover:text-cyan-500"
    >
      Ver Detalles 
      <!-- #007595 color -->
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" > 
        <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /> 
        <path d="M11 13l9 -9" /> 
        <path d="M15 4h5v5" /> 
      </svg>
    </a>
  </div>
</div>
