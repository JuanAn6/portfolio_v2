---
import BaseLayout from "../layouts/BaseLayout.astro";
import es from "../i18n/es";
import en from "../i18n/en";
import type { Language } from "../types/language.type";
import BoxComponent from '../components/BoxComponent.astro';
const lang = Astro.params.lang as Language;
const translations:any = { es, en };
const t:any = translations[lang];


const { project } = Astro.props;
---

<div class="bg-gray-50 dark:bg-gray-700 rounded-xl shadow-md overflow-hidden hover:shadow-xl transition duration-300 transform hover:-translate-y-1">
  <img
    class="w-full h-48 object-cover"
    src={project.img}
    alt="Imagen de Proyecto 1"
  />
  <div class="p-6">
    <h3 class="text-xl font-bold text-cyan-700 dark:text-cyan-500 mb-2">{project.title}</h3>
    <p class="text-gray-600 dark:text-gray-100 line-clamp-3">
      {project.description}
    </p>
    <a
      href={'projects/'+project.link}
      class="mt-4 inline-flex text-sm font-semibold text-cyan-700 dark:text-cyan-500 hover:text-cyan-200"
    >
      {t.projects.show_details}
      <!-- #007595 color -->
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" > 
        <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /> 
        <path d="M11 13l9 -9" /> 
        <path d="M15 4h5v5" /> 
      </svg>
    </a>
  </div>
</div>
