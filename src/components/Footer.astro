---
import { getTranslations } from "../i18n";
import { legalOwner, copyrightSince } from "../content/legal";
import type { Language } from "../types/language.type";

const lang = Astro.params.lang as Language;
const t = getTranslations(lang);

const base = import.meta.env.BASE_URL;

const year = new Date().getFullYear();
const years = year > copyrightSince ? `${copyrightSince}–${year}` : `${copyrightSince}`;

const links = [
  { href: `${base}${lang}/legal`, label: t.nav.legal },
  { href: `${base}${lang}/sitemap`, label: t.nav.sitemap },
];
---

<!-- Closing rule of the sheet, mirroring the header: hairline, no shadow. -->
<footer class="w-full border-t border-rule mt-16">
  <div
    class="max-w-6xl mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 px-6 py-6"
  >
    <p class="text-sm text-muted">
      &copy; {years} {legalOwner.name} &middot; {t.footer.rights}
    </p>

    <nav aria-label={t.footer.navLabel}>
      <ul class="flex flex-wrap gap-6">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-heading text-sm font-semibold uppercase tracking-[0.08em] text-ink no-underline hover:text-steel-text"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
