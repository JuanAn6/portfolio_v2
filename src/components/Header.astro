---
import ThemeToggle from "./ThemeToggle.astro";
import es from "../i18n/es";
import en from "../i18n/en";
import type { Language } from "../types/language.type";

const url = Astro.url.pathname;
const lang = Astro.params.lang as Language;
const translations:any = { es, en };
const t = translations[lang];


const languages = [
  { code: "es", label: t.languageOptions.es },
  { code: "en", label: t.languageOptions.en },
];



---

<header class="w-full bg-white dark:bg-gray-900 shadow sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto flex flex-wrap items-center justify-between p-4">
    <a href={`./${lang}/`} class="text-xl font-bold text-cyan-700">
      {t.nav.portfolio}
    </a>

    <button 
      id="menu-btn"
      aria-label="Toggle Menu"
      class="md:hidden p-2 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 rounded focus:outline-none"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>

    <div id="menu-items" class="hidden w-full md:flex md:w-auto md:items-center transition-all duration-300 ease-in-out">
      <div class="flex flex-col md:flex-row items-start md:items-center gap-6 mt-4 md:mt-0 pb-4 md:pb-0">
        
        <ul class="flex flex-col md:flex-row gap-6 text-sm font-medium w-full">
          <li><a href={`./${lang}/`} class="hover:text-cyan-500 block w-full">{t.nav.home}</a></li>
          <li><a href={`./${lang}/projects`} class="hover:text-cyan-500 block w-full">{t.nav.projects}</a></li>
          <li><a href={`./${lang}/about`} class="hover:text-cyan-500 block w-full">{t.nav.about_me}</a></li>
        </ul>

        <div class="flex items-center gap-4 border-t md:border-t-0 border-gray-100 dark:border-gray-800 pt-4 md:pt-0 w-full md:w-auto">
          <form id="lang-form">
            <select id="lang-select" class="dark:bg-gray-800 cursor-pointer p-1 rounded focus:outline-none ring-1 ring-transparent hover:ring-gray-300 dark:hover:ring-gray-600 text-sm">
              {languages.map((langOpt) => (
                <option value={langOpt.code} selected={langOpt.code === lang}>
                  {langOpt.label}
                </option>
              ))}
            </select>
          </form>
          <ThemeToggle />
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu-items');
  const menuIcon = document.getElementById('menu-icon');
  
  const burgerPath = "M4 6h16M4 12h16m-7 6h7";
  const closePath = "M6 18L18 6M6 6l12 12";
  
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const isHidden = menu?.classList.contains('hidden');
    menuIcon?.setAttribute('d', isHidden ? burgerPath : closePath);
  });

</script>
