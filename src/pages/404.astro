---
// Servido por Cloudflare (assets.not_found_handling: "404-page") para cualquier
// ruta inexistente. No usa BaseLayout: ese deriva `lang` de Astro.params, y
// aquí no hay params — la página vive fuera de [lang]/, así que es bilingüe.
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>404 — Juan Antonio García Jiménez</title>
    <meta name="robots" content="noindex" />
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "dark") document.documentElement.classList.add("dark");
          else if (stored === "light") document.documentElement.classList.remove("dark");
          else {
            //System theme if nothing saved in localStorage
            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
              document.documentElement.classList.add('dark');
            }
          }
        } catch (e) { console.error(e) }
      })();
    </script>
  </head>

  <body class="bg-gray-200 dark:bg-gray-800 text-gray-900 dark:text-gray-100">
    <main class="max-w-6xl mx-auto p-6 min-h-screen flex flex-col items-center justify-center gap-6 text-center">
      <p class="text-6xl font-bold text-gray-400 dark:text-gray-500">404</p>

      <div class="space-y-1">
        <p class="text-xl">Esta página no existe.</p>
        <p class="text-xl text-gray-600 dark:text-gray-400">This page doesn't exist.</p>
      </div>

      <div class="flex gap-4">
        <a
          href={`${base}es/`}
          class="rounded-lg px-4 py-2 bg-gray-300 dark:bg-gray-700 hover:bg-gray-400 dark:hover:bg-gray-600 transition-colors"
        >
          Ir al inicio
        </a>
        <a
          href={`${base}en/`}
          class="rounded-lg px-4 py-2 bg-gray-300 dark:bg-gray-700 hover:bg-gray-400 dark:hover:bg-gray-600 transition-colors"
        >
          Go home
        </a>
      </div>
    </main>
  </body>
</html>
