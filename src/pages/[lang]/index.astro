---
import BaseLayout from "../../layouts/BaseLayout.astro";
import es from "../../i18n/es";
import en from "../../i18n/en";
import type { Language } from "../../types/language.type";
import BoxText from '../../components/BoxText.astro';
import BoxComponent from '../../components/BoxComponent.astro';
import profile from '../../assets/imgs/profile.png';
import Github from '../../assets/github.astro';
import Linkedin from '../../assets/linkedin.astro';
import Email from '../../assets/email.astro';

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}
const lang = Astro.params.lang as Language;
const translations:any = { es, en };
const t:any = translations[lang];

export const defaultRedirect = "/es";


---

<BaseLayout lang={lang} t={t}>
  
  <div class="flex flex-col items-start">
      <h1 class="text-4xl font-bold ">{t.home.title}</h1>
      <h2 class="text-2xl mt-3">{t.home.subtitle}</h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
    <div class="flex-col flex gap-8 md:col-span-2">
      <BoxText text={t.home.introduce_my_self}></BoxText>
      <BoxText text={t.home.introduce_my_characteristics}></BoxText>
      <BoxText text={t.home.introduce_my_objectives}></BoxText>
      <BoxComponent>
        <div class="flex items-center justify-evenly">
          <a class="flex items-center hover:text-blue-600 transition" target="_blank" href="https://es.linkedin.com/in/juan-antonio-garc%C3%ADa-jim%C3%A9nez-651078236">
            <Linkedin /> Linkedin
          </a>
          <a class="flex items-center transition hover:text-gray-400" target="_blank" href="https://github.com/JuanAn6">
            <Github/> GitHub
          </a>
          <a class="flex items-center hover:text-red-600 transition" target="_blank" href="mailto:juanangarciaji@gmail.com">
            <Email/> Email
          </a>
        </div>
      </BoxComponent>
      
    </div>
    <div class="grid grid-cols-1 gap-8">
      <div class="flex">
        <BoxComponent>
          <img src={profile.src} />
        </BoxComponent>
      </div>
    </div>
  </div>
</BaseLayout>

