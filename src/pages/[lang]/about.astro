---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTranslations } from "../../i18n";
import type { Language } from "../../types/language.type";

export { getStaticPaths } from "../../i18n";

const lang = Astro.params.lang as Language;
const t = getTranslations(lang);
---

<BaseLayout title={`${t.about.title} — ${t.nav.my_name}`}>
  <section class="pb-12">
    <h1 class="display">{t.about.title}</h1>
  </section>

  <section>
    <span class="kicker">01 · {t.kickers.notes}</span>
    <hr class="caption-rule" />
    <p class="mt-8 font-heading text-2xl uppercase tracking-[0.04em] text-muted">
      {t.workingOnThis}
    </p>
  </section>
</BaseLayout>
