---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import type { Language } from '../../../../types/language.type';
import ExampleProjectComponent from '../../../../components/projects/ExampleProjectComponent.astro';
import ProjectHeader from '../../../../components/projects/ProjectHeader.astro';

export { getStaticPaths } from '../../../../i18n';

const lang = Astro.params.lang as Language;
const projectBase = `${import.meta.env.BASE_URL}${lang}/projects/example_project`;
---

<BaseLayout title="Example project">
  <div class='flex flex-col items-start'>
    <ProjectHeader title="Example project" projectBase={projectBase} active="info" />
    <ExampleProjectComponent />
  </div>
</BaseLayout>
