---
import BaseLayout from "../../layouts/BaseLayout.astro";

import es from "../../i18n/es";
import en from "../../i18n/en";
import type { Language } from "../../types/language.type";

import projectsEs from '../../content/es/projects';
import ProjectCard from '../../components/ProjectCard.astro'


export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}
const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];

export const defaultRedirect = "/es";

let projects:any = [];

switch(lang){
  case 'es':
    projects = projectsEs;
}



---

<BaseLayout>
  <h1 class="text-4xl font-bold">Projects</h1>
  <p class="mt-4">
    Esto es una pequeña coleción de proyectos que he hecho durante los años de estudio 
    y durante mi tiempo libre demientras de que trabajo.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
    { projects.map((p: any) => <ProjectCard project={p} /> ) }
  </div>

</BaseLayout>
