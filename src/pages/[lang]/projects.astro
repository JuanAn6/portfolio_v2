---
import BaseLayout from "../../layouts/BaseLayout.astro";

import es from "../../i18n/es";
import en from "../../i18n/en";
import type { Language } from "../../types/language.type";

import projectsEs from '../../content/projects_es';
import projectsEn from '../../content/projects_en';
import ProjectCard from '../../components/ProjectCard.astro'


export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}
const lang = Astro.params.lang as Language;
const translations:any = { es, en };
const t = translations[lang];

export const defaultRedirect = "/es";

let projects:any = [];

switch(lang){
  case 'es':
    projects = projectsEs;
    break;
  case 'en':
    projects = projectsEn;
    break;
  case 'ca':
    projects = projectsEs;
    // projects = projectsCa;
    break;
}



---

<BaseLayout>
  <h1 class="text-4xl font-bold">{t.projects.title}</h1>
  <p class="mt-4">
    {t.projects.introduction}
  </p>
  <h2 class="text-2xl mt-10 font-bold" >
    {t.workingOnThis}
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
    { projects.map((p: any) => <ProjectCard project={p} /> ) }
  </div>
  
</BaseLayout>
