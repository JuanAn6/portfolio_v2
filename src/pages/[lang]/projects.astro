---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getTranslations } from "../../i18n";
import type { Language } from "../../types/language.type";
import type { Project } from "../../types/project.type";

import projectsEs from '../../content/projects_es';
import projectsEn from '../../content/projects_en';
import ProjectCard from '../../components/ProjectCard.astro'

export { getStaticPaths } from "../../i18n";

const lang = Astro.params.lang as Language;
const t = getTranslations(lang);

const projectsByLang: Record<Language, Project[]> = { es: projectsEs, en: projectsEn };
const projects = projectsByLang[lang];
---

<BaseLayout title={`${t.projects.title} — ${t.nav.portfolio}`} description={t.projects.introduction}>
  <h1 class="text-4xl font-bold">{t.projects.title}</h1>
  <p class="mt-4">
    {t.projects.introduction}
  </p>
  <h2 class="text-2xl mt-10 font-bold" >
    {t.workingOnThis}
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
    { projects.map((p) => <ProjectCard project={p} /> ) }
  </div>
  
</BaseLayout>
