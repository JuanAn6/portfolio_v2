---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getTranslations } from "../../i18n";
import type { Language } from "../../types/language.type";
import type { Project } from "../../types/project.type";

import projectsEs from '../../content/projects_es';
import projectsEn from '../../content/projects_en';
import projectsCa from '../../content/projects_ca';
import ProjectCard from '../../components/ProjectCard.astro'

export { getStaticPaths } from "../../i18n";

const lang = Astro.params.lang as Language;
const t = getTranslations(lang);

const projectsByLang: Record<Language, Project[]> = { es: projectsEs, en: projectsEn, ca: projectsCa };
const projects = projectsByLang[lang];
---

<BaseLayout title={`${t.projects.title} — ${t.nav.my_name}`} description={t.projects.introduction}>
  <section class="pb-12">
    <h1 class="display">{t.projects.title}</h1>
    <p class="mt-6 max-w-[60ch] text-muted">
      {t.projects.introduction}
    </p>
  </section>

  <section>
    <span class="kicker">01 · {t.kickers.catalog}</span>
    <hr class="caption-rule" />

    <!-- The registration marks stick out 7px from the frame, so the gap between
         cells keeps a full unit of air. -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 mt-8">
      { projects.map((p) => <ProjectCard project={p} /> ) }
    </div>

    {projects.length === 0 && (
      <p class="mt-8 font-heading text-xl uppercase tracking-[0.04em] text-muted">
        {t.workingOnThis}
      </p>
    )}
  </section>
</BaseLayout>
