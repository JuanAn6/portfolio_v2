---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getTranslations } from "../i18n";
import type { Language } from "../types/language.type";
import '../styles/global.css'

interface Props {
  title?: string;
  description?: string;
}

const lang = Astro.params.lang as Language;
const t = getTranslations(lang);

const {
  title = `Juan Antonio García Jiménez`,
  description = t.home.introduce_my_self,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "dark") document.documentElement.classList.add("dark");
          else if (stored === "light") document.documentElement.classList.remove("dark");
          else {
            // System theme if nothing saved in localStorage
            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
              document.documentElement.classList.add('dark');
            }
          }
        } catch (e) { console.error(e) }
      })();
    </script>
  </head>

  <body class="bg-paper text-ink">
    <Header />

    <main class="max-w-6xl mx-auto px-6 py-10">
      <slot />
    </main>

    <Footer />

    <script>
      const base = import.meta.env.BASE_URL;
      const select = document.getElementById(
        "lang-select"
      ) as HTMLSelectElement | null;

      select?.addEventListener("change", ({ target }) => {
        const selectedLang = (target as HTMLSelectElement).value;
        // Strip the base before swapping the locale segment; the deployed site
        // lives under a subpath, so matching on a leading /es|/en never fires.
        const path = window.location.pathname.startsWith(base)
          ? window.location.pathname.slice(base.length)
          : window.location.pathname.replace(/^\//, "");
        const rest = path.split("/").slice(1).join("/");

        window.location.pathname = `${base}${selectedLang}${rest ? `/${rest}` : ""}`;
      });
    </script>
  </body>
</html>
