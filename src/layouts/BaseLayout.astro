---
import Header from "../components/Header.astro";
import '../styles/global.css'
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio</title>
    <!-- <slot name="title">Mi Portafolio</slot> -->
  </head>
  <script is:inline>
    (function() {
      try {
        const stored = localStorage.getItem("theme");
        console.log('theme',stored);
        if (stored === "dark") document.documentElement.classList.add("dark");
        else if (stored === "light") document.documentElement.classList.remove("dark");
        else {
          //System theme if nothing saved in localStorage
          if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      } catch (e) { console.error(e) }
    })();
  </script>

  <body class="bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100">
    <Header />

    <main class="max-w-6xl mx-auto p-6">
      <slot />
    </main>
  </body>
</html>
